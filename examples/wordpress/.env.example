# UWAS + WordPress Configuration
# Copy this file to .env.local and replace every placeholder.

# Domain
DOMAIN=example.com
ADMIN_EMAIL=admin@example.com

# Database
DB_ROOT_PASSWORD=replace_with_a_random_root_password
DB_NAME=wordpress
DB_USER=wordpress
DB_PASSWORD=replace_with_a_random_database_password

# UWAS admin
UWAS_ADMIN_KEY=replace_with_a_random_admin_key
ADMIN_PORT=9443

# Listener overrides (defaults shown)
HTTP_PORT=80
HTTPS_PORT=443
SSL_MODE=auto

# Optional: Cloudflare (for DNS-01 challenge)
# CF_API_TOKEN=replace_with_your_cloudflare_api_token
